| makeresults
| eval timestamp="2026-10-07T09:00:00Z"
| eval candidate_epoch=strptime(timestamp,"%Y-%m-%dT%H:%M:%SZ"), utc_epoch=strptime(replace(timestamp,"Z$","+0000"),"%Y-%m-%dT%H:%M:%S%z")
| eval expected_epoch=1791363600
| eval candidate_delta=candidate_epoch-expected_epoch, utc_delta=utc_epoch-expected_epoch
| table timestamp candidate_epoch utc_epoch expected_epoch candidate_delta utc_delta
